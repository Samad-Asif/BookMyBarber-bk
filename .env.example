PORT=5000

# Supabase — database/storage only (no Supabase Auth)
SUPABASE_URL=
SUPABASE_SECRET_KEY=sb_secret_...
# SUPABASE_PUBLISHABLE_KEY=optional legacy, not used for auth
# SUPABASE_SERVICE_ROLE_KEY=legacy fallback for SUPABASE_SECRET_KEY
# Supabase project JWT secret (Dashboard → Settings → API → JWT Secret) — minted
# authenticated JWTs for Realtime chat subscriptions. Never expose in client apps.
SUPABASE_JWT_SECRET=

# Local JWT auth (required)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Booking slot / pay-to-confirm (optional)
# BOOKING_MIN_LEAD_MINUTES=30
# BOOKING_PAYMENT_TIMEOUT_MINUTES=30

# Google login (mobile idToken verification)
GOOGLE_CLIENT_ID=
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=

# Microsoft login + calendar (same Azure app; separate redirect URIs)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_AUTH_REDIRECT_URI=bookmybarberapp://auth
MICROSOFT_AUTH_CALLBACK_URI=http://localhost:5000/v1/auth/microsoft/callback
MOBILE_AUTH_REDIRECT=bookmybarberapp://auth-complete

# SafePay (backend only — https://safepay-docs.netlify.app/)
SAFEPAY_SECRET_KEY=sec_your_secret_key
SAFEPAY_MERCHANT_API_KEY=your_merchant_api_key
SAFEPAY_ENV=sandbox
SAFEPAY_WEBHOOK_SECRET=your_webhook_secret
SAFEPAY_REDIRECT_URL=http://localhost:5173/payment/complete
SAFEPAY_CANCEL_URL=http://localhost:5173/payment/cancel

# Maps helpers (backend only — barber address search + customer route path)
GEOAPIFY_API_KEY=
ORS_API_KEY=
GRAPHHOPPER_API_KEY=
SHOPS_RADIUS_KM_DEFAULT=10
SHOPS_RADIUS_KM_MAX=50
MAPS_PROVIDER_CACHE_TTL_MS=60000

CORS_ORIGINS=http://localhost:5173,http://localhost:8081,http://localhost:19006,https://book-my-barber-admin.vercel.app
# When true (default), also allow localhost + ngrok browser origins (admin Vite on :5173 → ngrok API)
CORS_RELAX_DEV=true

# Direct connection host (db.<project-ref>.supabase.co:5432, IPv6 — server must have IPv6).
# Required for npm run db:migrate + booking advisory locks (withShopDateLock).
# Replace [YOUR-PASSWORD] with your database password (not the anon/service API key).
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.narmnxkgxohrcvpzonid.supabase.co:5432/postgres

# Google Calendar OAuth (barber — separate from login client)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5000/v1/calendar/google/callback

# Microsoft Calendar OAuth (barber)
MICROSOFT_CALENDAR_REDIRECT_URI=http://localhost:5000/v1/calendar/microsoft/callback
MOBILE_CALENDAR_REDIRECT=bookmybarberapp://calendar-connected

# Gmail / Nodemailer (App Password — enable 2FA, generate at https://myaccount.google.com/apppasswords)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cloudinary (image uploads — replaces Supabase Storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini AI (single-step analysis + image generation)
# Text models: gemini-2.5-flash, gemini-3.1-flash-preview
# Image models: gemini-2.5-flash-image, gemini-3.1-flash-image-preview, gemini-3-pro-image-preview
GEMINI_API_KEY=
