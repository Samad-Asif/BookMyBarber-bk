{
  "version": 2,
  "builds": [
    { "src": "src/index.ts", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "src/index.ts" }
  ],
  "crons": [
    {
      "path": "/v1/internal/haircut-queue/tick",
      "schedule": "* * * * *"
    }
  ],
  "functions": {
    "src/index.ts": {
      "maxDuration": 300
    }
  }
}
